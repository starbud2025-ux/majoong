<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 퍼미션은 docs/03 표에 승인된 것만 추가한다. 현재 선언 없음. -->
    <!-- 정차 전용 앱: distractionOptimized를 선언하지 않는다(CLAUDE.md 절대 규칙 1). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".GetOffApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.GetOff">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
